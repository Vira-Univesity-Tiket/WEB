<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # DO NOT TOUCH API
  RewriteRule ^api1(/.*)?$ - [L]
  RewriteRule ^socket(/.*)?$ - [L]
  # Existing files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # React SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>
