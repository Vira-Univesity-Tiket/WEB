# ========================================
# Single .env for Frontend + Backend
# ========================================

# Domain / URLs
APP_DOMAIN=vira.bog.co.ir
PUBLIC_SITE_URL=https://vira.bog.co.ir
PUBLIC_API_URL=/api1

# -------- Backend --------
BACKEND_NODE_ENV=production
PORT=5005
API_BASE_PATH=/api1
HEALTH_PATH=/healthz
TRUST_PROXY=true
ENV_DEBUG=false

# CORS (production)
FRONTEND_URL=https://vira.bog.co.ir,https://www.vira.bog.co.ir
CORS_ALLOWED_ORIGINS=https://vira.bog.co.ir,https://www.vira.bog.co.ir
CORS_ALLOWED_ORIGIN_REGEX=
CORS_INCLUDE_LOCALHOST=false
CORS_ALLOW_NO_ORIGIN=true
CORS_ALLOW_CREDENTIALS=true
FRONTEND_DEV_PORT=3000
CORS_MAX_AGE_SECONDS=3600

# Security (required)
JWT_SECRET=replace_with_strong_random_string_min_32_chars
SESSION_SECRET=replace_with_strong_random_string_min_32_chars
ADMIN_USERNAME=replace_admin_username
ADMIN_PASSWORD=replace_admin_password_min_12_chars

# Database (required)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace_db_user
DB_PASSWORD=replace_db_password
DB_NAME=replace_db_name
DB_CONN_LIMIT=10
# Production never loads demo passengers, drivers, schedules or balances.
SEED_DEMO_DATA=false

# Payment (optional)
# PAYMENT_GATEWAY=zarinpal
# ZARINPAL_MERCHANT_ID=
# PAYMENT_CALLBACK_URL=https://vira.bog.co.ir/api1/wallet/topup/callback
# PAYMENT_RETURN_URL=https://vira.bog.co.ir
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-zarinpal-signature
# PAYMENT_WEBHOOK_TIMESTAMP_HEADER=x-zarinpal-timestamp
# PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# ZARINPAL_SANDBOX=false

# -------- Frontend (Vite) --------
# Same-origin frontend -> backend
VITE_API_BASE_URL=/api1
VITE_API_BASE_PATH=/api1
VITE_API_RETRY_COUNT=1
VITE_ENV_DEBUG=false
